[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Dawson
	email = hello@dawson.gg
[alias]
	fame = !python3 -m gitfame
# Same helpers `gh auth setup-git` would write. The bootstrap runs
# `gh auth login` and does not run setup-git, because that rewrites this file.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
