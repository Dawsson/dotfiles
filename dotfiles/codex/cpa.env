# Sourced by ~/.zshrc and, as a fallback, ~/.bashrc. This file has no secrets.
# Key file (mode 600, not in git): ~/.codex/cpa-client-key
# One-line 1Password URI: ~/.codex/cpa-op-ref
# Default: op://Personal/Devbox CPA client key/credential

if [ -z "${CPA_API_KEY:-}" ]; then
  _cpa_key_file="${HOME}/.codex/cpa-client-key"
  _cpa_op_ref_file="${HOME}/.codex/cpa-op-ref"
  if [ ! -s "${_cpa_key_file}" ] && [ -s "${_cpa_op_ref_file}" ] && command -v op >/dev/null 2>&1; then
    IFS= read -r _cpa_ref < "${_cpa_op_ref_file}" || _cpa_ref=""
    _cpa_ref="${_cpa_ref#"${_cpa_ref%%[![:space:]]*}"}"
    _cpa_ref="${_cpa_ref%"${_cpa_ref##*[![:space:]]}"}"
    if [ -n "${_cpa_ref}" ]; then
      _cpa_key=$(op read "${_cpa_ref}" 2>/dev/null || true)
      if [ -n "${_cpa_key}" ]; then
        _cpa_umask=$(umask)
        umask 077
        printf '%s\n' "${_cpa_key}" > "${_cpa_key_file}"
        umask "${_cpa_umask}"
        chmod 600 "${_cpa_key_file}" 2>/dev/null || true
        unset _cpa_umask
      fi
    fi
  fi
  if [ -s "${_cpa_key_file}" ]; then
    CPA_API_KEY=$(tr -d '[:space:]' < "${_cpa_key_file}")
    export CPA_API_KEY
  fi
  unset _cpa_key_file _cpa_op_ref_file _cpa_ref _cpa_key
fi

# Opt-in. bootstrap.sh --with-claude-cpa creates ~/.codex/claude-cpa.enable.
# The CPA host is used without /v1. Anthropic compatibility is NOT verified.
if [ -f "${HOME}/.codex/claude-cpa.enable" ] && [ -n "${CPA_API_KEY:-}" ]; then
  if [ -z "${ANTHROPIC_BASE_URL:-}" ]; then
    ANTHROPIC_BASE_URL="https://devbox-dawson.tail20065d.ts.net"
    export ANTHROPIC_BASE_URL
  fi
  if [ -z "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
    ANTHROPIC_AUTH_TOKEN="${CPA_API_KEY}"
    export ANTHROPIC_AUTH_TOKEN
  fi
fi
