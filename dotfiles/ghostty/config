# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms
keybind = shift+enter=text:\n

adjust-cell-height = 30%

background = #121212
foreground = #dedede
selection-background = #474e91
selection-foreground = #f4f4f4
cursor-color = #ffa560
cursor-text = #ffffff
palette = 0=#929292
palette = 1=#e27373
palette = 2=#94b979
palette = 3=#ffba7b
palette = 4=#97bedc
palette = 5=#e1c0fa
palette = 6=#00988e
palette = 7=#dedede
palette = 8=#bdbdbd
palette = 9=#ffa1a1
palette = 10=#bddeab
palette = 11=#ffdca0
palette = 12=#b1d8f6
palette = 13=#fbdaff
palette = 14=#1ab2a8
palette = 15=#ffffff



# Minimal chrome on top of the existing palette.
font-family = JetBrainsMono Nerd Font
font-size = 13
window-padding-x = 12
window-padding-y = 8
# Terminal chords are native here (no keyd-application-mapper):
#   Ctrl+C/V = copy/paste when performable (no selection → Ctrl+C still SIGINT)
#   Alt+C    = always SIGINT via literal ^C
# keyd never remaps physical Ctrl. On Fedora, Alt+C is emitted as Ctrl+Insert
# (see keyd default.conf) so GUI Alt+C still copies; bind that to ^C here too.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
keybind = alt+c=text:\x03
keybind = ctrl+insert=text:\x03
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+q=quit
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+n=new_window

# SSH into hosts that lack Ghostty terminfo otherwise leaves TERM=xterm-ghostty
# mismatched, which shows up as paste junk like 200~ / ^[[200~. Install the
# entry when possible; fall back to xterm-256color + env forwarding if not.
shell-integration-features = ssh-terminfo,ssh-env
